# 메일을 발송할 네이버 계정 (SMTP 로그인용)
NAVER_EMAIL=hanys002@naver.com

# 네이버 메일 SMTP 로그인 비밀번호 (2단계 인증 사용 시 '애플리케이션 비밀번호' 발급 필요)
NAVER_APP_PASSWORD=여기에_비밀번호_입력

# 알림을 받을 주소 (본인에게 보내는 경우 위 NAVER_EMAIL과 동일하게)
MAIL_TO=hanys002@naver.com

# 검색 키워드 (쉼표로 여러 개 지정 가능)
SEARCH_KEYWORDS=기술사

# 사람인 검색 시 지역/직종 등을 더 좁히고 싶으면 추가 쿼리 파라미터를 넣을 수 있음 (선택)
SARAMIN_EXTRA_QUERY=
