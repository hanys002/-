# 카카오 개발자 사이트(https://developers.kakao.com)에서 발급받은 REST API 키
KAKAO_REST_API_KEY=여기에_REST_API_키_입력

# 카카오 로그인 시 사용한 리다이렉트 URI (개발자 콘솔에 등록한 것과 동일해야 함)
KAKAO_REDIRECT_URI=https://localhost.com

# kakao_auth.py 실행 후 자동으로 채워짐 (직접 입력할 필요 없음)
KAKAO_ACCESS_TOKEN=
KAKAO_REFRESH_TOKEN=

# 검색 키워드 (쉼표로 여러 개 지정 가능)
SEARCH_KEYWORDS=기술사

# 사람인 검색 시 지역/직종 등을 더 좁히고 싶으면 추가 쿼리 파라미터를 넣을 수 있음 (선택)
SARAMIN_EXTRA_QUERY=
